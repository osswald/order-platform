# Local dev: copy to .env and use devpass123 / admin@vendiqo.local / admin123;
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174; REFRESH_COOKIE_SECURE=false; ENABLE_OPENAPI=true.
# If POSTGRES_* changes after first start, run: docker compose down -v (local only — wipes DB volume).

# PostgreSQL
POSTGRES_USER=cloud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloud
# Optional: bind mount on the VPS, e.g. POSTGRES_DATA_PATH=/data/postgres
# POSTGRES_DATA_PATH=/data/postgres

# Backend
# Set APP_ENV=production on the VPS (see docker-compose.prod.yml). Local dev omits this (defaults to development).
# In production, SECRET_KEY must be a unique random string (32+ chars); dev may omit it for a built-in default.
SECRET_KEY=change-me-to-a-long-random-string
# Include marketing site origins so the Mietanfrage form can call the API
ALLOWED_ORIGINS=https://admin.vendiqo.ch,https://vendiqo.ch,https://www.vendiqo.ch
REFRESH_COOKIE_SECURE=true
ENABLE_OPENAPI=false
LOGIN_RATE_LIMIT=10/minute
REFRESH_RATE_LIMIT=30/minute
RENTAL_INQUIRY_RATE_LIMIT=5/minute
# Behind Caddy (prod): use leftmost X-Forwarded-For for rate-limit keys
# RATE_LIMIT_TRUST_PROXY=true

# Mietanfrage form → email (required in production for POST /public/rental-inquiry)
RENTAL_INQUIRY_TO=kontakt@vendiqo.ch
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@vendiqo.ch
# SMTP_TLS=true

# SumUp Cloud API (OAuth connect, Solo readers, edge checkouts)
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
# Must match an Authorized redirect URL on the SumUp OAuth client exactly (API callback).
SUMUP_REDIRECT_URI=https://api.vendiqo.ch/sumup/oauth/callback
# Space-separated; defaults omit restricted `payments` until SumUp activates it on the app.
# SUMUP_OAUTH_SCOPES=transactions.history readers.read readers.write user.profile_readonly
SUMUP_AFFILIATE_KEY=
SUMUP_AFFILIATE_APP_ID=
SUMUP_WEBHOOK_SECRET=
# After OAuth callback, redirect tenant admin to SumUp-Geräte page
# SUMUP_FRONTEND_RETURN_URL=https://admin.vendiqo.ch/sumup-devices

# Bootstrap first superuser (optional; only created if no user with this email exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Frontend build (baked into the static image at build time)
VITE_API_BASE_URL=https://api.vendiqo.ch

# Hosted Cloud Pi (config-event browser sandbox)
HOSTED_PI_MANAGER_SECRET=change-me-to-a-long-random-string
HOSTED_PI_BASE_DOMAIN=demo.vendiqo.ch
HOSTED_PI_CLOUD_BASE_URL=https://api.vendiqo.ch
# PI_BACKEND_IMAGE=ghcr.io/<owner>/order-platform:pi-backend-amd64-latest
# PI_FRONTEND_IMAGE=ghcr.io/<owner>/order-platform:pi-frontend-amd64-latest
# CADDY_NETWORK=cloud_app-net
# CADDY_CONTAINER=cloud-caddy-1
