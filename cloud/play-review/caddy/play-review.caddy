# Canonical install path is cloud/hosted-snippets/play-review.caddy (tracked in git).
# Prefer: ./scripts/ensure-play-review-caddy.sh
# Manual: copy that file into the VPS hosted-snippets dir and reload Caddy.

play-review.demo.vendiqo.ch {
	import security_headers
	reverse_proxy play-review-pi-frontend-1:80 {
		header_down -Server
	}
}
