{
  "name": "cloud-frontend",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "generate:api-types": "openapi-typescript ./openapi.json -o ./src/types/api.generated.ts",
    "lint": "eslint --config ../../eslint.config.js src"
  },
  "dependencies": {
    "@date-io/date-fns": "^3.2.1",
    "@mdi/js": "^7.4.47",
    "chart.js": "^4.5.1",
    "date-fns": "^4.4.0",
    "markdown-it": "^15.0.0",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.41",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.2",
    "openapi-typescript": "^7.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.10"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@intlify/vue-i18n-extensions": "9.0.0",
    "js-yaml": "^4.3.0",
    "brace-expansion": "^5.0.8",
    "js-beautify": {
      "glob": "^13.0.6"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
